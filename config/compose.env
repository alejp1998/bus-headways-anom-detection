# Environment for the bus-headways compose stack.
# NOTE: this file may reference api_credentials.py (gitignored) for EMT/TfL keys.

# EMT Madrid MobilityLabs (X-ClientId / passKey are read from api_credentials.py)
EMT_ENABLED=false

# TfL app key (optional — the TfL Unified API works without a key)
TFL_APP_KEY=

# Mapbox token (optional; falls back to free carto tiles)
MAPBOX_ACCESS_TOKEN=
